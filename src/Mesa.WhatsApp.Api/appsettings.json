{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=mesa_whatsapp.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Hangfire": {
    "Storage": "Memory"
  },
  "WhatsApp": {
    "BusinessAccountId": "",
    "PhoneNumberId": "",
    "AccessToken": "",
    "AppSecret": "",
    "VerifyToken": "",
    "GraphApiVersion": "v20.0",
    "DefaultLanguage": "en",
    "GraphApiBaseUrl": "https://graph.facebook.com"
  },
  "Jwt": {
    "Issuer": "Mesa.WhatsApp",
    "Audience": "Mesa.WhatsApp.Admin",
    "SigningKey": "DEV_ONLY_CHANGE_ME_MESA_WHATSAPP_JWT_KEY_32+",
    "ExpiryMinutes": 480
  },
  "CampaignEngine": {
    "TimeZoneId": "Asia/Kolkata",
    "DefaultDailyCap": 200,
    "DefaultPacingDelayMs": 3000,
    "DefaultPacingJitterMs": 1500,
    "MaxRetries": 3,
    "TransientErrorCodes": [ 130429, 131000 ],
    "SpamOrRateLimitErrorCodes": [ 131048, 131056, 130429 ],
    "DefaultBlockReportRateThreshold": 0.05,
    "CompanyPhone": "+91 8855008116",
    "CompanySignOff": "Team UB Nexora Technologies | +91 8855008116",
    "ClosingLine": "Let's connect!",
    "QrNfcLine": "Scan the QR or tap NFC, no app needed"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 300
      },
      {
        "Endpoint": "*:/api/webhooks/*",
        "Period": "1m",
        "Limit": 120
      },
      {
        "Endpoint": "*:/api/auth/login",
        "Period": "1m",
        "Limit": 20
      }
    ]
  },
  "Swagger": {
    "Enabled": true
  }
}
